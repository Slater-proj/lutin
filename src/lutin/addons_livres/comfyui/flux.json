{
 "version": 1,
 "appels": {
  "etat": {
   "methode": "GET",
   "url": "http://127.0.0.1:{port}/system_stats",
   "extraire": {
    "version": "system.comfyui_version",
    "gpu": "devices.0.name"
   }
  },
  "objets_checkpoints": {
   "methode": "GET",
   "url": "http://127.0.0.1:{port}/object_info/CheckpointLoaderSimple",
   "extraire": {
    "liste": "CheckpointLoaderSimple.input.required.ckpt_name"
   }
  },
  "objets_loras": {
   "methode": "GET",
   "url": "http://127.0.0.1:{port}/object_info/LoraLoader",
   "extraire": {
    "liste": "LoraLoader.input.required.lora_name"
   }
  },
  "objets_vae": {
   "methode": "GET",
   "url": "http://127.0.0.1:{port}/object_info/VAELoader",
   "extraire": {
    "liste": "VAELoader.input.required.vae_name"
   }
  },
  "objets_unet": {
   "methode": "GET",
   "url": "http://127.0.0.1:{port}/object_info/UNETLoader",
   "extraire": {
    "liste": "UNETLoader.input.required.unet_name"
   }
  },
  "soumettre": {
   "methode": "POST",
   "url": "http://127.0.0.1:{port}/prompt",
   "corps": {
    "prompt": "{workflow}"
   },
   "extraire": {
    "id": "prompt_id"
   }
  },
  "historique": {
   "methode": "GET",
   "url": "http://127.0.0.1:{port}/history/{id}"
  },
  "interrompre": {
   "methode": "POST",
   "url": "http://127.0.0.1:{port}/interrupt",
   "corps": {}
  },
  "objets_clip": {
   "methode": "GET",
   "url": "http://127.0.0.1:{port}/object_info/CLIPLoader",
   "extraire": {
    "liste": "CLIPLoader.input.required.clip_name"
   }
  }
 },
